# =============================================================================
# YETZO FRONTEND PRODUCTION ENVIRONMENT VARIABLES (.env.production)
# =============================================================================

# Public Backend REST API Gateway URL
NEXT_PUBLIC_API_URL=https://api.yetzo.com/api

# Public WebSocket Gateway for Daphne / Realtime Push Notifications
NEXT_PUBLIC_WS_URL=wss://api.yetzo.com/ws

# Server-Side Backend URL (Used by Next.js Server Components and API Proxy)
BACKEND_API_URL=https://api.yetzo.com

# Node Environment
NODE_ENV=production
